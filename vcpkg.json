{
  "vcpkg-configuration": {
    "overlay-ports": [
      "cmake/ports"
    ],
    "overlay-triplets": [
      "cmake/triplets"
    ]
  },
  "name": "alumbra",
  "builtin-baseline": "9a5dfef5d1a0438a7d24856a85bd60f309d355e9",
  "dependencies": [
    "abseil"
  ],
  "features": {
    "desktop": {
      "description": "Media libraries for the desktop reference port",
      "dependencies": [
        "dav1d",
        {
          "name": "ffmpeg",
          "default-features": false,
          "features": [
            "avcodec",
            "avformat",
            "swresample"
          ]
        },
        {
          "name": "sdl3",
          "default-features": false,
          "features": [
            "vulkan",
            {
              "name": "wayland",
              "platform": "linux"
            },
            {
              "name": "x11",
              "platform": "linux"
            }
          ]
        },
        {
          "name": "sdl3-shadercross",
          "host": true,
          "platform": "linux & x64"
        },
        {
          "name": "sdl3",
          "host": true,
          "default-features": false,
          "features": [
            "vulkan"
          ],
          "platform": "linux & x64"
        }
      ]
    },
    "tests": {
      "description": "Test and benchmark frameworks",
      "dependencies": [
        "benchmark",
        "gtest"
      ]
    }
  }
}
