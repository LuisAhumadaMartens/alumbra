{
  "vcpkg-configuration": {
    "overlay-ports": [
      "cmake/ports"
    ],
    "overlay-triplets": [
      "cmake/triplets"
    ]
  },
  "name": "alumbra",
  "builtin-baseline": "9a5dfef5d1a0438a7d24856a85bd60f309d355e9",
  "dependencies": [
    "abseil",
    "libunibreak",
    "sheenbidi"
  ],
  "features": {
    "desktop": {
      "description": "Media libraries for the desktop reference port",
      "dependencies": [
        {
          "name": "curl",
          "default-features": false,
          "features": [
            "http2",
            "openssl"
          ]
        },
        "dav1d",
        {
          "name": "ffmpeg",
          "default-features": false,
          "features": [
            "avcodec",
            "avformat",
            "swresample"
          ],
          "platform": "!windows"
        },
        {
          "name": "freetype",
          "default-features": false
        },
        {
          "name": "harfbuzz",
          "default-features": false
        },
        {
          "name": "sdl3",
          "default-features": false,
          "features": [
            {
              "name": "alsa",
              "platform": "linux"
            },
            "vulkan",
            {
              "name": "wayland",
              "platform": "linux"
            },
            {
              "name": "x11",
              "platform": "linux"
            }
          ]
        },
        {
          "name": "sdl3-shadercross",
          "host": true,
          "platform": "linux & x64"
        },
        {
          "name": "sdl3",
          "host": true,
          "default-features": false,
          "features": [
            "vulkan"
          ],
          "platform": "linux & x64"
        }
      ]
    },
    "decoder-fuzz": {
      "description": "FFmpeg libraries for fuzzing the desktop decoder wrapper",
      "dependencies": [
        {
          "name": "ffmpeg",
          "default-features": false,
          "features": ["avcodec"]
        }
      ]
    },
    "patent-free-ffmpeg": {
      "description": "Build the desktop FFmpeg decoder set without patent-pool-covered codecs",
      "dependencies": [
        {
          "name": "ffmpeg",
          "default-features": false,
          "features": [
            "avcodec",
            "avformat",
            "swresample",
            "patent-free"
          ]
        }
      ]
    },
    "tests": {
      "description": "Test and benchmark frameworks",
      "dependencies": [
        "benchmark",
        "gtest"
      ]
    }
  }
}
