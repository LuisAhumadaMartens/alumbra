<VAST version="4.3">
  <Ad id="track-ad">
    <InLine>
      <Impression>https://track.test/impression?cb=[CACHEBUSTING]&amp;app=[APPBUNDLE]</Impression>
      <Error>https://track.test/error?code=[ERRORCODE]</Error>
      <Creatives>
        <Creative id="track-creative">
          <Linear>
            <TrackingEvents>
              <Tracking event="creativeView">https://track.test/view</Tracking>
              <Tracking event="start">https://track.test/start?at=[ADPLAYHEAD]</Tracking>
              <Tracking event="progress" offset="00:00:05.000">https://track.test/progress?at=[MEDIAPLAYHEAD]</Tracking>
              <Tracking event="progress" offset="25%">https://track.test/progress?at=[CONTENTPLAYHEAD]</Tracking>
              <Tracking event="firstQuartile">https://track.test/first</Tracking>
              <Tracking event="midpoint">https://track.test/mid</Tracking>
              <Tracking event="thirdQuartile">https://track.test/third</Tracking>
              <Tracking event="pause">https://track.test/pause</Tracking>
              <Tracking event="resume">https://track.test/resume</Tracking>
              <Tracking event="mute">https://track.test/mute</Tracking>
              <Tracking event="unmute">https://track.test/unmute</Tracking>
              <Tracking event="complete">https://track.test/complete</Tracking>
              <Tracking event="skip">https://track.test/skip</Tracking>
            </TrackingEvents>
            <VideoClicks>
              <ClickTracking>https://track.test/click</ClickTracking>
            </VideoClicks>
          </Linear>
        </Creative>
      </Creatives>
    </InLine>
  </Ad>
</VAST>
