cmake_minimum_required(VERSION 3.28)

if(NOT DEFINED ALUMBRA_VCPKG_MANIFEST)
  set(ALUMBRA_VCPKG_MANIFEST "${CMAKE_CURRENT_LIST_DIR}/../vcpkg.json")
endif()
cmake_path(ABSOLUTE_PATH ALUMBRA_VCPKG_MANIFEST NORMALIZE)
cmake_path(GET ALUMBRA_VCPKG_MANIFEST PARENT_PATH _manifest_dir)
set(_allowed_ffmpeg_features avcodec avformat swresample)

function(alumbra_manifest_error text)
  set_property(GLOBAL APPEND PROPERTY ALUMBRA_MANIFEST_ERRORS "${text}")
endfunction()

function(alumbra_is_commit_sha out value)
  string(LENGTH "${value}" _length)
  if(_length EQUAL 40 AND value MATCHES "^[0-9a-f]+$")
    set(${out} TRUE PARENT_SCOPE)
  else()
    set(${out} FALSE PARENT_SCOPE)
  endif()
endfunction()

function(alumbra_check_registry registry)
  string(JSON _kind ERROR_VARIABLE _missing GET "${registry}" kind)
  if(NOT _kind MATCHES "^(builtin|git)$")
    alumbra_manifest_error("registry kind '${_kind}' is not allowed")
    return()
  endif()
  string(JSON _baseline ERROR_VARIABLE _missing GET "${registry}" baseline)
  alumbra_is_commit_sha(_pinned "${_baseline}")
  if(NOT _pinned)
    alumbra_manifest_error(
      "${_kind} registry baseline must be a full 40-character commit SHA")
  endif()
endfunction()

function(alumbra_check_configuration configuration)
  string(JSON _default ERROR_VARIABLE _missing
    GET "${configuration}" default-registry)
  if(NOT _missing)
    alumbra_check_registry("${_default}")
  endif()
  string(JSON _count ERROR_VARIABLE _missing
    LENGTH "${configuration}" registries)
  if(NOT _missing AND _count GREATER 0)
    math(EXPR _last "${_count} - 1")
    foreach(_index RANGE ${_last})
      string(JSON _registry GET "${configuration}" registries ${_index})
      alumbra_check_registry("${_registry}")
    endforeach()
  endif()
  foreach(_member IN ITEMS overlay-ports overlay-triplets)
    string(JSON _count ERROR_VARIABLE _missing
      LENGTH "${configuration}" ${_member})
    if(_missing OR _count EQUAL 0)
      continue()
    endif()
    math(EXPR _last "${_count} - 1")
    foreach(_index RANGE ${_last})
      string(JSON _path GET "${configuration}" ${_member} ${_index})
      cmake_path(SET _normalized NORMALIZE "${_path}")
      if(IS_ABSOLUTE "${_path}" OR _normalized MATCHES "^\\.\\.(/|$)")
        alumbra_manifest_error(
          "overlay path '${_path}' must stay inside the repository")
      endif()
    endforeach()
  endforeach()
endfunction()

function(alumbra_check_ffmpeg dependency)
  string(JSON _type TYPE "${dependency}")
  if(_type STREQUAL "STRING")
    alumbra_manifest_error("ffmpeg must set default-features to false")
    return()
  endif()
  string(JSON _default ERROR_VARIABLE _missing
    GET "${dependency}" default-features)
  if(_missing OR NOT _default STREQUAL "OFF")
    alumbra_manifest_error("ffmpeg must set default-features to false")
  endif()
  string(JSON _count ERROR_VARIABLE _missing LENGTH "${dependency}" features)
  if(_missing OR _count EQUAL 0)
    return()
  endif()
  math(EXPR _last "${_count} - 1")
  foreach(_index RANGE ${_last})
    string(JSON _feature GET "${dependency}" features ${_index})
    string(JSON _type TYPE "${dependency}" features ${_index})
    if(_type STREQUAL "OBJECT")
      string(JSON _feature GET "${_feature}" name)
    endif()
    if(NOT _feature IN_LIST _allowed_ffmpeg_features)
      alumbra_manifest_error("ffmpeg feature '${_feature}' is not allowed")
    endif()
  endforeach()
endfunction()

function(alumbra_check_dependencies json)
  string(JSON _count ERROR_VARIABLE _missing LENGTH "${json}" dependencies)
  if(_missing OR _count EQUAL 0)
    return()
  endif()
  math(EXPR _last "${_count} - 1")
  foreach(_index RANGE ${_last})
    string(JSON _dependency GET "${json}" dependencies ${_index})
    string(JSON _type TYPE "${json}" dependencies ${_index})
    set(_name "${_dependency}")
    if(_type STREQUAL "OBJECT")
      string(JSON _name GET "${_dependency}" name)
    else()
      set(_dependency "\"${_dependency}\"")
    endif()
    if(_name STREQUAL "ffmpeg")
      alumbra_check_ffmpeg("${_dependency}")
    endif()
  endforeach()
endfunction()

file(READ "${ALUMBRA_VCPKG_MANIFEST}" _manifest)

string(JSON _baseline ERROR_VARIABLE _missing GET "${_manifest}" builtin-baseline)
alumbra_is_commit_sha(_pinned "${_baseline}")
if(NOT _pinned)
  alumbra_manifest_error("builtin-baseline must be a full 40-character commit SHA")
endif()

string(JSON _overrides ERROR_VARIABLE _missing GET "${_manifest}" overrides)
if(NOT _missing)
  alumbra_manifest_error(
    "overrides need a recorded rationale under ADR-0014; none is approved")
endif()

string(JSON _configuration ERROR_VARIABLE _missing
  GET "${_manifest}" vcpkg-configuration)
if(NOT _missing)
  alumbra_check_configuration("${_configuration}")
endif()
if(EXISTS "${_manifest_dir}/vcpkg-configuration.json")
  file(READ "${_manifest_dir}/vcpkg-configuration.json" _configuration)
  alumbra_check_configuration("${_configuration}")
endif()

alumbra_check_dependencies("${_manifest}")
string(JSON _feature_count ERROR_VARIABLE _missing LENGTH "${_manifest}" features)
if(NOT _missing AND _feature_count GREATER 0)
  math(EXPR _last "${_feature_count} - 1")
  foreach(_index RANGE ${_last})
    string(JSON _feature_name MEMBER "${_manifest}" features ${_index})
    string(JSON _feature GET "${_manifest}" features ${_feature_name})
    alumbra_check_dependencies("${_feature}")
  endforeach()
endif()

get_property(_errors GLOBAL PROPERTY ALUMBRA_MANIFEST_ERRORS)
if(_errors)
  list(JOIN _errors "\n  - " _report)
  message(FATAL_ERROR
    "${ALUMBRA_VCPKG_MANIFEST} violates the dependency pinning policy:\n"
    "  - ${_report}")
endif()
message(STATUS "${ALUMBRA_VCPKG_MANIFEST} satisfies the dependency pinning policy")
