@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
message(STATUS
  "Alumbra requires Abseil @ALUMBRA_ABSL_VERSION@ exactly for its static-library ABI. "
  "Set absl_DIR to that release's package directory or rebuild Alumbra with your Abseil release.")
find_dependency(absl @ALUMBRA_ABSL_VERSION@ EXACT CONFIG)
find_dependency(Threads)
if(@ALUMBRA_PORT_DESKTOP@)
  find_dependency(CURL CONFIG REQUIRED)
  find_dependency(SDL3 CONFIG REQUIRED)
  find_dependency(PkgConfig REQUIRED)
  pkg_check_modules(DAV1D REQUIRED IMPORTED_TARGET dav1d)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/AlumbraTargets.cmake")
check_required_components(Alumbra)
