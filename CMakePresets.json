{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "desktop",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "anyOf",
        "conditions": [
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Darwin"
          },
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Linux"
          }
        ]
      },
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "ALUMBRA_BUILD_TESTS": true,
        "ALUMBRA_PORT": "desktop",
        "ALUMBRA_BUILD_UI": true,
        "ALUMBRA_BUILD_ADS": true,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_OSX_SYSROOT": "macosx",
        "VCPKG_MANIFEST_MODE": true,
        "VCPKG_APPLOCAL_DEPS": false
      }
    },
    {
      "name": "apple-slice",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/apple/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "ALUMBRA_BUILD_TESTS": false,
        "ALUMBRA_PORT": "none",
        "ALUMBRA_BUILD_UI": false,
        "ALUMBRA_WARNINGS_AS_ERRORS": true,
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/apple/${presetName}/install",
        "VCPKG_MANIFEST_MODE": true,
        "VCPKG_APPLOCAL_DEPS": false
      }
    },
    {
      "name": "apple-ios-arm64",
      "inherits": "apple-slice",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "17.0",
        "VCPKG_TARGET_TRIPLET": "arm64-ios-alumbra"
      }
    },
    {
      "name": "apple-ios-simulator-arm64",
      "inherits": "apple-slice",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "17.0",
        "VCPKG_TARGET_TRIPLET": "arm64-ios-simulator-alumbra"
      }
    },
    {
      "name": "apple-tvos-arm64",
      "inherits": "apple-slice",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "tvOS",
        "CMAKE_OSX_SYSROOT": "appletvos",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "17.0",
        "VCPKG_TARGET_TRIPLET": "arm64-tvos-alumbra"
      }
    },
    {
      "name": "apple-tvos-simulator-arm64",
      "inherits": "apple-slice",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "tvOS",
        "CMAKE_OSX_SYSROOT": "appletvsimulator",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "17.0",
        "VCPKG_TARGET_TRIPLET": "arm64-tvos-simulator-alumbra"
      }
    },
    {
      "name": "apple-xcframework",
      "displayName": "Apple XCFramework",
      "inherits": "desktop",
      "cacheVariables": {
        "ALUMBRA_BUILD_TESTS": false,
        "ALUMBRA_PORT": "none",
        "ALUMBRA_BUILD_UI": false,
        "ALUMBRA_BUILD_APPLE_XCFRAMEWORK": true,
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug",
      "displayName": "Desktop Debug",
      "inherits": "desktop",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Desktop Release",
      "inherits": "desktop",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan",
      "displayName": "Desktop ASan and UBSan",
      "inherits": "debug",
      "cacheVariables": {
        "ALUMBRA_SANITIZER": "address"
      }
    },
    {
      "name": "tsan",
      "displayName": "Desktop TSan",
      "inherits": "debug",
      "cacheVariables": {
        "ALUMBRA_SANITIZER": "thread"
      }
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer with ASan and UBSan (upstream Clang)",
      "inherits": "asan",
      "cacheVariables": {
        "ALUMBRA_FUZZING": true,
        "ALUMBRA_PORT": "none"
      }
    },
    {
      "name": "core",
      "displayName": "Core only (no port, no tests)",
      "inherits": "debug",
      "cacheVariables": {
        "ALUMBRA_PORT": "none",
        "ALUMBRA_BUILD_TESTS": false,
        "ALUMBRA_BUILD_ADS": false
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "targets": ["alumbra_fuzz"]
    },
    { "name": "core", "configurePreset": "core" },
    {
      "name": "apple-ios-arm64",
      "configurePreset": "apple-ios-arm64",
      "targets": ["umbra_c_api"]
    },
    {
      "name": "apple-ios-simulator-arm64",
      "configurePreset": "apple-ios-simulator-arm64",
      "targets": ["umbra_c_api"]
    },
    {
      "name": "apple-tvos-arm64",
      "configurePreset": "apple-tvos-arm64",
      "targets": ["umbra_c_api"]
    },
    {
      "name": "apple-tvos-simulator-arm64",
      "configurePreset": "apple-tvos-simulator-arm64",
      "targets": ["umbra_c_api"]
    },
    {
      "name": "apple-xcframework",
      "configurePreset": "apple-xcframework",
      "targets": ["alumbra_apple_xcframework"]
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" },
      "filter": { "exclude": { "label": "^quarantine$" } }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" },
      "filter": { "exclude": { "label": "^quarantine$" } }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" },
      "filter": { "exclude": { "label": "^quarantine$" } }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" },
      "filter": { "exclude": { "label": "^quarantine$" } }
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" },
      "filter": {
        "include": { "label": "^fuzz_" },
        "exclude": { "label": "^quarantine$" }
      }
    },
    {
      "name": "apple-xcframework",
      "configurePreset": "apple-xcframework",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "steps": [
        { "type": "configure", "name": "debug" },
        { "type": "build", "name": "debug" },
        { "type": "test", "name": "debug" }
      ]
    },
    {
      "name": "release",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" },
        { "type": "test", "name": "release" }
      ]
    },
    {
      "name": "asan",
      "steps": [
        { "type": "configure", "name": "asan" },
        { "type": "build", "name": "asan" },
        { "type": "test", "name": "asan" }
      ]
    },
    {
      "name": "tsan",
      "steps": [
        { "type": "configure", "name": "tsan" },
        { "type": "build", "name": "tsan" },
        { "type": "test", "name": "tsan" }
      ]
    },
    {
      "name": "fuzz",
      "steps": [
        { "type": "configure", "name": "fuzz" },
        { "type": "build", "name": "fuzz" },
        { "type": "test", "name": "fuzz" }
      ]
    },
    {
      "name": "core",
      "steps": [
        { "type": "configure", "name": "core" },
        { "type": "build", "name": "core" }
      ]
    },
    {
      "name": "apple-xcframework",
      "steps": [
        { "type": "configure", "name": "apple-xcframework" },
        { "type": "build", "name": "apple-xcframework" },
        { "type": "test", "name": "apple-xcframework" }
      ]
    }
  ]
}
