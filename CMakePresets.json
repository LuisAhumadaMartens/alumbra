{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "desktop",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "anyOf",
        "conditions": [
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Darwin"
          },
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Linux"
          }
        ]
      },
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "ALUMBRA_BUILD_TESTS": true,
        "ALUMBRA_PORT": "desktop",
        "ALUMBRA_BUILD_UI": true,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_OSX_SYSROOT": "macosx",
        "VCPKG_MANIFEST_MODE": true,
        "VCPKG_APPLOCAL_DEPS": false
      }
    },
    {
      "name": "debug",
      "displayName": "Desktop Debug",
      "inherits": "desktop",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Desktop Release",
      "inherits": "desktop",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan",
      "displayName": "Desktop ASan and UBSan",
      "inherits": "debug",
      "cacheVariables": {
        "ALUMBRA_SANITIZER": "address"
      }
    },
    {
      "name": "tsan",
      "displayName": "Desktop TSan",
      "inherits": "debug",
      "cacheVariables": {
        "ALUMBRA_SANITIZER": "thread"
      }
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer with ASan and UBSan (upstream Clang)",
      "inherits": "asan",
      "cacheVariables": {
        "ALUMBRA_FUZZING": true,
        "ALUMBRA_PORT": "none"
      }
    },
    {
      "name": "core",
      "displayName": "Core only (no port, no tests)",
      "inherits": "debug",
      "cacheVariables": {
        "ALUMBRA_PORT": "none",
        "ALUMBRA_BUILD_TESTS": false
      }
    },
    {
      "name": "wasm",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "anyOf",
        "conditions": [
          { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
          { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
        ]
      },
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Emscripten",
        "CMAKE_C_COMPILER": "$env{EMSDK}/upstream/emscripten/emcc",
        "CMAKE_CXX_COMPILER": "$env{EMSDK}/upstream/emscripten/em++",
        "ALUMBRA_BUILD_TESTS": true,
        "ALUMBRA_WARNINGS_AS_ERRORS": true,
        "ALUMBRA_PORT": "none",
        "ALUMBRA_BUILD_UI": false,
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_SCAN_FOR_MODULES": false,
        "CMAKE_CROSSCOMPILING_EMULATOR": "$env{EMSDK_NODE};${sourceDir}/tools/wasm/run_gtest.mjs",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "VCPKG_MANIFEST_MODE": true,
        "VCPKG_TARGET_TRIPLET": "wasm32-emscripten",
        "CMAKE_CXX_FLAGS": "-msimd128 -fexceptions",
        "CMAKE_EXE_LINKER_FLAGS": "-msimd128 -fexceptions -sMODULARIZE -sEXPORT_ES6 -sINITIAL_MEMORY=67108864 -sMAXIMUM_MEMORY=536870912 -sALLOW_MEMORY_GROWTH=1"
      }
    },
    {
      "name": "wasm-debug",
      "displayName": "WASM Debug",
      "inherits": "wasm",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "wasm-release",
      "displayName": "WASM Release",
      "inherits": "wasm"
    },
    {
      "name": "wasm-threaded",
      "displayName": "Threaded WASM Release",
      "inherits": "wasm",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-msimd128 -fexceptions -pthread",
        "VCPKG_TARGET_TRIPLET": "wasm32-emscripten-threaded",
        "CMAKE_EXE_LINKER_FLAGS": "-msimd128 -fexceptions -pthread -sMODULARIZE -sEXPORT_ES6 -sINITIAL_MEMORY=67108864 -sMAXIMUM_MEMORY=536870912 -sALLOW_MEMORY_GROWTH=1 -sPTHREAD_POOL_SIZE=4"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "targets": ["alumbra_fuzz"]
    },
    { "name": "core", "configurePreset": "core" },
    { "name": "wasm-debug", "configurePreset": "wasm-debug" },
    { "name": "wasm-release", "configurePreset": "wasm-release" },
    { "name": "wasm-threaded", "configurePreset": "wasm-threaded" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" },
      "filter": { "exclude": { "label": "^quarantine$" } }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" },
      "filter": { "exclude": { "label": "^quarantine$" } }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" },
      "filter": { "exclude": { "label": "^quarantine$" } }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" },
      "filter": { "exclude": { "label": "^quarantine$" } }
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" },
      "filter": {
        "include": { "label": "^fuzz_" },
        "exclude": { "label": "^quarantine$" }
      }
    },
    {
      "name": "wasm-debug",
      "configurePreset": "wasm-debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "wasm-release",
      "configurePreset": "wasm-release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "wasm-threaded",
      "configurePreset": "wasm-threaded",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "steps": [
        { "type": "configure", "name": "debug" },
        { "type": "build", "name": "debug" },
        { "type": "test", "name": "debug" }
      ]
    },
    {
      "name": "release",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" },
        { "type": "test", "name": "release" }
      ]
    },
    {
      "name": "asan",
      "steps": [
        { "type": "configure", "name": "asan" },
        { "type": "build", "name": "asan" },
        { "type": "test", "name": "asan" }
      ]
    },
    {
      "name": "tsan",
      "steps": [
        { "type": "configure", "name": "tsan" },
        { "type": "build", "name": "tsan" },
        { "type": "test", "name": "tsan" }
      ]
    },
    {
      "name": "fuzz",
      "steps": [
        { "type": "configure", "name": "fuzz" },
        { "type": "build", "name": "fuzz" },
        { "type": "test", "name": "fuzz" }
      ]
    },
    {
      "name": "core",
      "steps": [
        { "type": "configure", "name": "core" },
        { "type": "build", "name": "core" }
      ]
    },
    {
      "name": "wasm-debug",
      "steps": [
        { "type": "configure", "name": "wasm-debug" },
        { "type": "build", "name": "wasm-debug" },
        { "type": "test", "name": "wasm-debug" }
      ]
    },
    {
      "name": "wasm-release",
      "steps": [
        { "type": "configure", "name": "wasm-release" },
        { "type": "build", "name": "wasm-release" },
        { "type": "test", "name": "wasm-release" }
      ]
    },
    {
      "name": "wasm-threaded",
      "steps": [
        { "type": "configure", "name": "wasm-threaded" },
        { "type": "build", "name": "wasm-threaded" },
        { "type": "test", "name": "wasm-threaded" }
      ]
    }
  ]
}
