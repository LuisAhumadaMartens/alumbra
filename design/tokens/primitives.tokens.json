{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "$type": "color",
    "neutral": {
      "0": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 1, 1],
          "hex": "#ffffff"
        }
      },
      "50": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.973, 0.98, 0.988],
          "hex": "#f8fafc"
        }
      },
      "100": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.945, 0.961, 0.976],
          "hex": "#f1f5f9"
        }
      },
      "200": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.886, 0.91, 0.941],
          "hex": "#e2e8f0"
        }
      },
      "300": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.796, 0.835, 0.882],
          "hex": "#cbd5e1"
        }
      },
      "400": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.58, 0.639, 0.722],
          "hex": "#94a3b8"
        }
      },
      "500": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.392, 0.455, 0.545],
          "hex": "#64748b"
        }
      },
      "600": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.278, 0.333, 0.412],
          "hex": "#475569"
        }
      },
      "700": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.2, 0.255, 0.333],
          "hex": "#334155"
        }
      },
      "800": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.118, 0.161, 0.231],
          "hex": "#1e293b"
        }
      },
      "900": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.059, 0.09, 0.165],
          "hex": "#0f172a"
        }
      },
      "950": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.035, 0.055, 0.094],
          "hex": "#090e18"
        }
      },
      "1000": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0, 0, 0],
          "hex": "#000000"
        }
      }
    },
    "blue": {
      "500": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.055, 0.647, 0.914],
          "hex": "#0ea5e9"
        }
      },
      "600": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.008, 0.518, 0.78],
          "hex": "#0284c7"
        }
      },
      "700": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.012, 0.412, 0.631],
          "hex": "#0369a1"
        }
      }
    },
    "scrim": {
      "media": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0, 0, 0],
          "alpha": 0.72,
          "hex": "#000000"
        },
        "$description": "Composited over the current video frame; no fixed backdrop or contrast ratio is claimed."
      }
    },
    "scheme": {
      "$type": "color",
      "normal": {
        "surface": {
          "$value": "{color.neutral.950}"
        },
        "surface_elevated": {
          "$value": "{color.neutral.900}"
        },
        "surface_overlay": {
          "$value": "{color.neutral.800}"
        },
        "text_primary": {
          "$value": "{color.neutral.50}"
        },
        "text_secondary": {
          "$value": "{color.neutral.300}"
        },
        "control": {
          "$value": "{color.neutral.800}"
        },
        "control_hover": {
          "$value": "{color.neutral.700}"
        },
        "control_pressed": {
          "$value": "{color.neutral.600}"
        },
        "control_disabled": {
          "$value": "{color.neutral.800}"
        },
        "control_foreground": {
          "$value": "{color.neutral.0}"
        },
        "border": {
          "$value": "{color.neutral.500}"
        },
        "focus": {
          "$value": "{color.blue.500}"
        }
      },
      "high": {
        "surface": {
          "$value": "{color.neutral.1000}"
        },
        "surface_elevated": {
          "$value": "{color.neutral.1000}"
        },
        "surface_overlay": {
          "$value": "{color.neutral.1000}"
        },
        "text_primary": {
          "$value": "{color.neutral.0}"
        },
        "text_secondary": {
          "$value": "{color.neutral.0}"
        },
        "control": {
          "$value": "{color.neutral.1000}"
        },
        "control_hover": {
          "$value": "{color.neutral.900}"
        },
        "control_pressed": {
          "$value": "{color.neutral.800}"
        },
        "control_disabled": {
          "$value": "{color.neutral.1000}"
        },
        "control_foreground": {
          "$value": "{color.neutral.0}"
        },
        "border": {
          "$value": "{color.neutral.0}"
        },
        "focus": {
          "$value": {
            "colorSpace": "srgb",
            "components": [1, 1, 0],
            "hex": "#ffff00"
          }
        }
      }
    }
  },
  "typography": {
    "font_family": {
      "system_ui": {
        "$type": "fontFamily",
        "$value": ["system-ui"],
        "$description": "Platform-neutral system UI fallback; platform-specific stacks are staged for renderer work."
      },
      "apple": {
        "$type": "fontFamily",
        "$value": ["SF Pro Text", "SF Pro Display"],
        "$description": "Apple platform system font stack."
      },
      "android": {
        "$type": "fontFamily",
        "$value": ["Roboto"],
        "$description": "Android platform system font stack."
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    },
    "scale": {
      "caption": {
        "$type": "dimension",
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "body": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "title": {
        "$type": "dimension",
        "$value": {
          "value": 24,
          "unit": "px"
        }
      },
      "display": {
        "$type": "dimension",
        "$value": {
          "value": 32,
          "unit": "px"
        }
      }
    },
    "leading": {
      "compact": {
        "$type": "number",
        "$value": 1.2
      },
      "body": {
        "$type": "number",
        "$value": 1.5
      }
    }
  },
  "space": {
    "$type": "dimension",
    "0": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "1": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "2": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "3": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "4": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "6": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "8": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "12": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    }
  },
  "radius": {
    "scale": {
      "$type": "dimension",
      "none": {
        "$value": {
          "value": 0,
          "unit": "px"
        }
      },
      "small": {
        "$value": {
          "value": 4,
          "unit": "px"
        }
      },
      "medium": {
        "$value": {
          "value": 8,
          "unit": "px"
        }
      },
      "large": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "pill": {
        "$value": {
          "value": 999,
          "unit": "px"
        }
      }
    }
  },
  "elevation": {
    "$type": "shadow",
    "level_1": {
      "$value": {
        "color": "{color.neutral.1000}",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 2,
          "unit": "px"
        },
        "blur": {
          "value": 6,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "level_2": {
      "$value": {
        "color": "{color.neutral.1000}",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 4,
          "unit": "px"
        },
        "blur": {
          "value": 12,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "level_3": {
      "$value": {
        "color": "{color.neutral.1000}",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 8,
          "unit": "px"
        },
        "blur": {
          "value": 24,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  },
  "motion": {
    "time": {
      "instant": {
        "$type": "duration",
        "$value": {
          "value": 0,
          "unit": "ms"
        }
      },
      "short": {
        "$type": "duration",
        "$value": {
          "value": 120,
          "unit": "ms"
        }
      },
      "medium": {
        "$type": "duration",
        "$value": {
          "value": 200,
          "unit": "ms"
        }
      },
      "long": {
        "$type": "duration",
        "$value": {
          "value": 320,
          "unit": "ms"
        }
      }
    },
    "curve": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [0.2, 0, 0, 1]
      },
      "emphasized": {
        "$type": "cubicBezier",
        "$value": [0.2, 0, 0, 1.4]
      }
    }
  },
  "target": {
    "size": {
      "minimum": {
        "$type": "dimension",
        "$value": {
          "value": 44,
          "unit": "px"
        },
        "$description": "Minimum width and height for an interactive target in the desktop density context."
      }
    }
  },
  "opacity": {
    "scale": {
      "$type": "number",
      "disabled": {
        "$value": 0.48
      }
    }
  },
  "layer": {
    "stack": {
      "$type": "number",
      "video_surface": {
        "$value": 0
      },
      "captions": {
        "$value": 10
      },
      "controls": {
        "$value": 20
      },
      "ad_chrome": {
        "$value": 30
      },
      "ad_sdk_container": {
        "$value": 40
      }
    }
  },
  "luminance": {
    "value": {
      "reference_white": {
        "$type": "number",
        "$value": 203,
        "$description": "HDR graphics reference-white luminance in cd/m2 per ITU-R BT.2408."
      },
      "hdr_highlight_ceiling": {
        "$type": "number",
        "$value": 203,
        "$description": "SDR ceiling at reference white in cd/m2; HDR mode adds highlight headroom."
      }
    }
  }
}
