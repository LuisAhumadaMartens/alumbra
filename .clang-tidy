---
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  google-*,
  misc-*,
  -misc-non-private-member-variables-in-classes,
  modernize-*,
  -modernize-use-trailing-return-type,
  performance-*,
  portability-*,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  -google-readability-namespace-comments,
  -performance-enum-size,
  -cppcoreguidelines-avoid-do-while,
  -bugprone-macro-parentheses,
  -misc-no-recursion,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -clang-analyzer-optin.core.EnumCastOutOfRange
WarningsAsErrors: ''
HeaderFilterRegex: '(^|/)(umbra|penumbra|antumbra|test)/.*'
ExcludeHeaderFilterRegex: '(^|/)(build|generated|third_party|third-party|vendor|vcpkg|vcpkg_installed)/'
FormatStyle: file
CheckOptions:
  - key: cppcoreguidelines-macro-usage.AllowedRegexp
    value: '^ALUMBRA_[A-Z0-9_]+$'
  - key: cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor
    value: true
  - key: cppcoreguidelines-special-member-functions.AllowMissingMoveFunctions
    value: true
  - key: cppcoreguidelines-special-member-functions.AllowMissingMoveFunctionsWhenCopyIsDeleted
    value: true
  - key: readability-identifier-naming.LocalConstantCase
    value: lower_case
  - key: readability-identifier-naming.LocalConstantPrefix
    value: ''
  - key: readability-identifier-naming.LocalConstantIgnoredRegexp
    value: '^k[A-Z].*'
  - key: readability-identifier-naming.ConstantMemberCase
    value: lower_case
  - key: readability-identifier-naming.ConstantMemberPrefix
    value: ''
  - key: readability-identifier-naming.ConstantMemberSuffix
    value: _
  - key: readability-identifier-naming.FunctionIgnoredRegexp
    value: '^(is_.*|has_.*|empty|size|data|begin|end|numerator|denominator|span|type|worker_count|clock|executor|priority|get|reset|received|entries|names|count)$'
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: CamelCase
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.ConstantPrefix
    value: k
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
