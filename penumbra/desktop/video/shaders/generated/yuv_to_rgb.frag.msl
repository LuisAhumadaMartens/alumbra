#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_ConversionParams
{
    float4 scale;
    float4 bias0;
    float4 matrix_row_red;
    float4 matrix_row_green;
    float4 matrix_row_blue;
    float4 chroma_transform;
    float4 layout_flags;
};

struct main0_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

struct main0_in
{
    float2 in_var_TEXCOORD0 [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant type_ConversionParams& ConversionParams [[buffer(0)]], texture2d<float> luma_plane [[texture(0)]], texture2d<float> first_chroma_plane [[texture(1)]], texture2d<float> second_chroma_plane [[texture(2)]], sampler luma_sampler [[sampler(0)]], sampler first_chroma_sampler [[sampler(1)]], sampler second_chroma_sampler [[sampler(2)]])
{
    main0_out out = {};
    float2 _48 = (in.in_var_TEXCOORD0 * ConversionParams.chroma_transform.xy) + ConversionParams.chroma_transform.zw;
    float4 _57 = first_chroma_plane.sample(first_chroma_sampler, _48);
    float3 _76 = (float3(luma_plane.sample(luma_sampler, in.in_var_TEXCOORD0).x, _57.x, mix(second_chroma_plane.sample(second_chroma_sampler, _48).x, _57.y, ConversionParams.layout_flags.x)) * ConversionParams.scale.xyz) + ConversionParams.bias0.xyz;
    out.out_var_SV_Target0 = float4(fast::clamp(float3(dot(ConversionParams.matrix_row_red.xyz, _76), dot(ConversionParams.matrix_row_green.xyz, _76), dot(ConversionParams.matrix_row_blue.xyz, _76)), float3(0.0), float3(1.0)), 1.0);
    return out;
}

